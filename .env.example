# Backend server port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/ageflow

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Admin Seeding Credentials (run npm run seed:admin)
ADMIN_EMAIL=admin@ageflow.com
ADMIN_PASSWORD=change_this_to_a_secure_password

#backend API URL for frontend (Vite)
VITE_API_URL=https://login-page-backend-gr7t.onrender.com/api